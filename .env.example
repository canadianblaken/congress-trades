# Copy to .env and fill in what you need. .env is gitignored.
#
# Both run.sh and `python -m congress_trades` read this file now. Anything
# already exported in your shell wins over what is written here, so
#   CONGRESS_OLLAMA_MODEL=gemma4:12b python -m congress_trades resolve
# still overrides the file for one run.

# --- who you are ------------------------------------------------------------
# Not a key. The SEC answers 403 to anonymous automated clients, so `sectors`
# and `all` stop without it. Use a real address.
CONGRESS_CONTACT=you@example.com

# --- Congress.gov, for committee meeting titles -----------------------------
# Free key from https://api.congress.gov/sign-up/. Needed by `committees` and by
# `topics --stage fetch`; everything else works without it, and a snapshot of
# meeting DATES ships in seed/ so `timing` runs on a fresh clone.
# CONGRESS_API_KEY=

# --- which model, for `advise`, `resolve` and `topics` ----------------------
# Easiest from the portal: Maintenance tab -> Model -> pick, List models, Save.
# It writes these same lines.
#
# openai = any /chat/completions endpoint (OpenAI, LiteLLM, vLLM, OpenRouter,
#          Groq, Together, and Ollama's own compatibility shim).
# anthropic = Claude through the official SDK (pip install anthropic). Key
#          optional after `ant auth login` -- see the README.
# ollama = Ollama's native API, which is what the batch passes want: it takes a
#          real context size, constrains decoding to a JSON schema, and can turn
#          a thinking model's thinking off.
CONGRESS_LLM_PROVIDER=ollama

# provider = ollama
CONGRESS_OLLAMA_MODEL=qwen3.8:27b
# CONGRESS_OLLAMA_BASE=http://127.0.0.1:11434
# Raise for long batches. The OpenAI shim would silently serve the Modelfile's
# num_ctx instead -- often 4096 -- and drop whatever overflowed.
# CONGRESS_OLLAMA_NUM_CTX=8192
# CONGRESS_OLLAMA_THINK=0
# CONGRESS_OLLAMA_KEEP_ALIVE=5m

# provider = anthropic
# CONGRESS_LLM_MODEL=claude-opus-5-5
# CONGRESS_LLM_KEY=sk-ant-...

# provider = openai
# CONGRESS_LLM_MODEL=gpt-4o
# CONGRESS_LLM_BASE=http://127.0.0.1:4000/v1
# CONGRESS_LLM_KEY=

# --- storage (all optional) -------------------------------------------------
# CONGRESS_DB=./data/congress.db
# CONGRESS_CACHE=./cache
# CONGRESS_OUT=./out/congress.html
# CONGRESS_DEFAULT_FLOOR=15001
